          "anyOf": [{ "type": "string", "enum": ["direct", "via-github", "via-coordinator"] }, { "type": "null" }]
        },
        "routineGitWrites": { "anyOf": [{ "type": "boolean" }, { "type": "null" }] },
        "lastCiPoll": { "anyOf": [{ "type": "string" }, { "type": "null" }] },
        "thresholds": {
          "type": "object",
          "properties": {
            "health": { "type": "object" },
            "lighthouse": { "type": "object" },
            "uniqueness": { "type": "object" },
            "stopGate": { "type": "object", "properties": { "attempts": { "type": "integer", "minimum": 1 } } },
            "policyHealth": { "type": "object" }
          }
        },
        "stages": { "type": "array", "items": { "$ref": "#/$defs/stage" } },
        "types": { "type": "array", "items": { "$ref": "#/$defs/type" } },
        "environments": {
          "type": "object",
          "properties": {
            "sites": { "anyOf": [{ "type": "string" }, { "type": "null" }] },
            "ppc": { "anyOf": [{ "type": "string" }, { "type": "null" }] }
          }
        },
        "limits": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": { "name": { "type": "string" }, "value": { "type": "number" }, "unit": { "type": "string" } }
          }
        },
        "ciMinutesBudget": { "anyOf": [{ "type": "integer", "minimum": 0 }, { "type": "null" }] },
        "capacity": {
          "type": "object",
          "properties": {
            "maxInFlight": { "type": "integer", "minimum": 0 },
            "waveSize": { "type": "integer", "minimum": 0 }
          }
        }
      },
      "$comment": "config/factory"
    }
  }
}
