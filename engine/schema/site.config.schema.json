{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://factory.invalid/engine/schema/site.config.schema.json",
  "title": "sites/<slug>/site.config.json, v1",
  "description": "Phase 1 (MASTER-PLAN D-48): the keys engine/build.mjs reads today plus the required \"type\" and \"storagePrefix\". client config.js serialises a whitelist of keys, so adding keys here never changes a build. v2 (MASTER-PLAN 4.2) replaces this in Phase 2.",
  "type": "object",
  "required": ["type", "storagePrefix", "brand", "shortName", "domain", "currency", "operator", "analytics", "lastUpdated", "themeColor"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "type": { "enum": ["social-casino", "online-games", "hotel-casino"], "description": "The type pack: types/<type>/pack.mjs." },
    "storagePrefix": {
      "type": "string",
      "pattern": "^[a-z0-9]{2,8}$",
      "description": "Bare prefix for localStorage keys, events and the service-worker cache (the engine adds the separators). Recorded in Phase 1; substituted in Phase 2."
    },
    "brand": { "type": "string", "minLength": 1 },
    "shortName": { "type": "string", "minLength": 1 },
    "domain": { "type": "string", "pattern": "^[a-z0-9.-]+\\.[a-z]{2,}$" },
    "concept": { "type": "string" },
    "currency": {
      "type": "object",
      "required": ["singular", "plural", "abbr", "startingBalance", "topUpAmount", "topUpBelow"],
      "additionalProperties": false,
      "properties": {
        "singular": { "type": "string", "minLength": 1 },
        "plural": { "type": "string", "minLength": 1 },
        "abbr": { "type": "string", "minLength": 1 },
        "startingBalance": { "type": "integer", "minimum": 1 },
        "topUpAmount": { "type": "integer", "minimum": 1 },
        "topUpBelow": { "type": "integer", "minimum": 0 }
      }
    },
    "operator": {
      "type": "object",
      "required": ["companyName", "companyNumber", "registeredIn", "address", "email"],
      "additionalProperties": false,
      "description": "Every value is a string; a value in [brackets] is a placeholder (lint 'placeholder': a warning, an error under --strict).",
      "properties": {
        "companyName": { "type": "string" },
        "companyNumber": { "type": "string" },
        "registeredIn": { "type": "string" },
        "address": { "type": "string" },
        "email": { "type": "string", "pattern": "^[^@\\s]+@[^@\\s]+$" }
      }
    },
    "purchases": { "type": "boolean" },
    "analytics": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ga4": { "type": "string", "pattern": "^(G-[A-Z0-9]+)?$" },
        "adsConversionId": { "type": "string", "pattern": "^(AW-[0-9]+)?$" }
      }
    },
    "contactEndpoint": { "type": "string", "pattern": "^(https://\\S+)?$" },
    "lastUpdated": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "legalUpdated": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "terms": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "privacy": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "cookies": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
      }
    },
    "themeColor": {
      "type": "object",
      "required": ["light", "dark"],
      "additionalProperties": false,
      "properties": {
        "light": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
        "dark": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" }
      }
    },
    "pragmatic": {
      "type": "object",
      "required": ["enabled"],
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "writtenConsent": { "type": "string" },
        "featured": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
        "demoUrl": { "type": "string", "pattern": "^https://\\S+$" },
        "params": { "type": "object", "additionalProperties": { "type": "string" } },
        "frameHosts": { "type": "array", "items": { "type": "string", "pattern": "^https://[^/\\s]+$" } }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "pragmatic": { "properties": { "enabled": { "const": true } } } }, "required": ["pragmatic"] },
      "then": { "properties": { "pragmatic": { "required": ["enabled", "demoUrl", "params", "frameHosts"] } } }
    },
    {
      "if": { "properties": { "type": { "not": { "const": "social-casino" } } }, "required": ["type"] },
      "then": { "properties": { "pragmatic": { "properties": { "enabled": { "const": false } } } } }
    }
  ]
}
