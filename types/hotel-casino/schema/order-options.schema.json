{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://factory.invalid/types/hotel-casino/schema/order-options.schema.json",
  "title": "order.json typeOptions for type hotel-casino (stub)",
  "description": "Phase 1 stub (MASTER-PLAN 6.3, 3.4): the SITE-TYPES 6.2 identifiers for a hotel-casino order, including casinoMode and locales, so tools/validate-order.mjs can record them. Mode A (default) is a casino-free domain; A+ is lawyer-gated; B needs its own domain and Google's written confirmation. The full shape (rooms, offers, venues, gallery, booking adapters, geo tables) arrives with the full pack in Phase 4.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "variant",
    "casinoMode",
    "locales",
    "venue"
  ],
  "properties": {
    "variant": {
      "enum": [
        "single-hotel",
        "integrated-resort",
        "resort-group"
      ]
    },
    "casinoMode": {
      "enum": [
        "A",
        "A+",
        "B"
      ],
      "description": "A property of the domain: A = no casino reference anywhere; A+ = amenity mention only, lawyer sign-off; B = casino content on its own domain."
    },
    "locales": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "path",
          "dir"
        ],
        "properties": {
          "code": {
            "type": "string",
            "pattern": "^[a-z]{2}(-[A-Z]{2})?$"
          },
          "path": {
            "type": "string",
            "pattern": "^/([a-z]{2}/)?$"
          },
          "default": {
            "type": "boolean"
          },
          "dir": {
            "enum": [
              "ltr",
              "rtl"
            ]
          }
        }
      }
    },
    "venue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "country"
      ],
      "properties": {
        "country": {
          "type": "string",
          "pattern": "^[A-Z]{2}$"
        },
        "entryAge": {
          "enum": [
            18,
            21,
            25
          ]
        },
        "regulator": {
          "type": "string"
        },
        "licenceNumber": {
          "type": "string"
        },
        "casinoOperatorLegalName": {
          "type": "string",
          "description": "Owner or lessee of the casino; client-supplied, never invented."
        },
        "casinoLinkedVenues": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Venue ids the client marks as casino-linked; events in them derive casinoEvent."
        }
      }
    },
    "booking": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "provider": {
          "type": "string"
        },
        "engineUrlTemplate": {
          "type": "string",
          "pattern": "^https://\\S+$"
        },
        "hosts": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^https://[^/\\s]+$"
          }
        },
        "affiliateId": {
          "type": "string"
        },
        "campaignLabel": {
          "type": "string"
        },
        "affiliatePaidSearch": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "permitted"
          ],
          "properties": {
            "permitted": {
              "type": [
                "boolean",
                "null"
              ]
            },
            "clauseRef": {
              "type": "string"
            }
          }
        }
      }
    },
    "modeConfirmation": {
      "type": "object",
      "additionalProperties": false,
      "description": "Mode B: Google's written confirmation that offline-gambling promotion of this venue to the target markets is permitted (launch gate), and the GB Gambling Act opinion when GB is targeted.",
      "properties": {
        "googleWritten": {
          "type": [
            "string",
            "null"
          ],
          "description": "Reference and date of Google's written answer."
        },
        "gbOpinion": {
          "type": [
            "string",
            "null"
          ],
          "description": "Reference of the Gambling Act 2005 opinion (GB targets)."
        },
        "lawyer": {
          "type": [
            "string",
            "null"
          ],
          "description": "Mode A+: the lawyer who signed off the amenity wording."
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "casinoMode": {
            "const": "B"
          }
        },
        "required": [
          "casinoMode"
        ]
      },
      "then": {
        "required": [
          "modeConfirmation"
        ],
        "properties": {
          "modeConfirmation": {
            "type": "object"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "casinoMode": {
            "const": "A+"
          }
        },
        "required": [
          "casinoMode"
        ]
      },
      "then": {
        "required": [
          "modeConfirmation"
        ],
        "properties": {
          "modeConfirmation": {
            "type": "object",
            "required": [
              "lawyer"
            ],
            "properties": {
              "lawyer": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    }
  ]
}
