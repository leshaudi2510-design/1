{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://factory.invalid/types/social-casino/schema/order-options.schema.json",
  "title": "order.json typeOptions for type social-casino",
  "description": "Validated by tools/validate-order.mjs over schemas/order.schema.json (1.2) for orders with \"type\": \"social-casino\". The blocks are the intake audit's (order schema 1.0) with SPEC 4.1 amendments 1 (three house games in every mode) and 2 (demo currency FUN only). Variant demo-lobby (Pragmatic demos on) is never advertisable: validate-order rejects it with any Google Ads ID at --level draft. Top-level order fields (type, variant, casinoMode, locales) are validated by schemas/order.schema.json, not here.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "currency",
    "games",
    "purchases",
    "ageVerification"
  ],
  "properties": {
    "currency": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "singular",
        "plural",
        "abbr",
        "startingBalance",
        "topUpAmount",
        "topUpBelow"
      ],
      "properties": {
        "singular": {
          "type": "string",
          "minLength": 2,
          "maxLength": 16
        },
        "plural": {
          "type": "string",
          "minLength": 2,
          "maxLength": 18
        },
        "abbr": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4
        },
        "startingBalance": {
          "type": "integer",
          "minimum": 100,
          "maximum": 100000
        },
        "topUpAmount": {
          "type": "integer",
          "minimum": 50,
          "maximum": 100000
        },
        "topUpBelow": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        },
        "origin": {
          "type": "string",
          "description": "Why this unit belongs to the world."
        }
      }
    },
    "games": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "house",
        "pragmatic"
      ],
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "house",
            "pragmatic"
          ],
          "description": "house: only our own games, the only build that can be certified for Google Ads. pragmatic: Pragmatic Play demos plus at least two house tables; needs written consent."
        },
        "house": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/houseGame"
          },
          "minItems": 3
        },
        "pragmatic": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enabled"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "writtenConsent": {
              "oneOf": [
                {
                  "type": "null"
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "reference",
                    "from",
                    "date"
                  ],
                  "properties": {
                    "reference": {
                      "type": "string",
                      "minLength": 3
                    },
                    "from": {
                      "type": "string"
                    },
                    "date": {
                      "$ref": "#/$defs/date"
                    }
                  }
                }
              ]
            },
            "featured": {
              "$ref": "#/$defs/slug"
            },
            "demos": {
              "type": "array",
              "uniqueItems": true,
              "maxItems": 11,
              "items": {
                "$ref": "#/$defs/slug"
              },
              "description": "Slugs from types/social-casino/data/pragmatic-catalog.json; appeal must be low or medium there."
            },
            "params": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "lang",
                "cur",
                "jurisdiction",
                "websiteUrl"
              ],
              "properties": {
                "lang": {
                  "const": "en"
                },
                "cur": {
                  "const": "FUN"
                },
                "jurisdiction": {
                  "const": "UK"
                },
                "websiteUrl": {
                  "type": "string",
                  "format": "uri"
                }
              }
            },
            "demoUrl": {
              "type": "string",
              "format": "uri"
            },
            "frameHosts": {
              "type": "array",
              "items": {
                "type": "string",
                "format": "uri"
              }
            }
          }
        }
      }
    },
    "purchases": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "priceGbp",
              "whatYouGet"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "priceGbp": {
                "type": "number",
                "minimum": 0
              },
              "whatYouGet": {
                "type": "string"
              }
            }
          }
        },
        "disclosure": {
          "type": "string",
          "description": "Shown on the landing page and beside every game when enabled."
        }
      }
    },
    "ageVerification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method"
      ],
      "properties": {
        "method": {
          "type": "string",
          "enum": [
            "self-declaration",
            "third-party"
          ]
        },
        "provider": {
          "type": "string"
        },
        "decidedBy": {
          "type": "string"
        },
        "decidedOn": {
          "$ref": "#/$defs/date"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "variant": {
            "const": "own-games"
          }
        },
        "required": [
          "variant"
        ]
      },
      "then": {
        "properties": {
          "games": {
            "type": "object",
            "properties": {
              "mode": {
                "const": "house"
              },
              "pragmatic": {
                "type": "object",
                "properties": {
                  "enabled": {
                    "const": false
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "variant": {
            "const": "demo-lobby"
          }
        },
        "required": [
          "variant"
        ]
      },
      "then": {
        "properties": {
          "games": {
            "type": "object",
            "properties": {
              "mode": {
                "const": "pragmatic"
              },
              "pragmatic": {
                "type": "object",
                "required": [
                  "enabled",
                  "writtenConsent",
                  "demos",
                  "params"
                ],
                "properties": {
                  "enabled": {
                    "const": true
                  },
                  "writtenConsent": {
                    "type": "object"
                  },
                  "demos": {
                    "type": "array",
                    "minItems": 3
                  },
                  "params": {
                    "type": "object"
                  }
                }
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "description": "ISO date; shown on the site as '25 September 2026'."
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "maxLength": 40
    },
    "houseGame": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "slug",
        "name",
        "engine",
        "spec",
        "coverMotif",
        "tileFacts",
        "status"
      ],
      "properties": {
        "slug": {
          "$ref": "#/$defs/slug"
        },
        "name": {
          "type": "string",
          "minLength": 3,
          "maxLength": 32,
          "description": "Unique across the whole portfolio; never a real slot or studio name."
        },
        "engine": {
          "type": "string",
          "enum": [
            "reel-slot",
            "european-roulette",
            "blackjack",
            "hi-lo",
            "dice",
            "video-poker",
            "baccarat",
            "wheel-of-fortune",
            "keno",
            "scratch-card",
            "plinko",
            "custom"
          ],
          "description": "reel-slot, european-roulette and blackjack exist today (seven-systems, lapidary-wheel, brilliant-21 maths); the others are engine-library work orders."
        },
        "spec": {
          "type": "object",
          "description": "Engine parameters; shape depends on engine (see the conditional rules)."
        },
        "coverMotif": {
          "type": "string",
          "minLength": 10,
          "description": "Objects and places only."
        },
        "tileFacts": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "string",
            "maxLength": 16
          }
        },
        "tags": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "table",
              "freespins",
              "tumble",
              "megaways"
            ]
          },
          "description": "Only features the game really has (build.mjs checks)."
        },
        "rtpNote": {
          "type": "string",
          "description": "How the RTP is established: exact enumeration, 36/37, or Monte Carlo with hand count."
        },
        "status": {
          "type": "string",
          "enum": [
            "proposed",
            "approved",
            "implemented",
            "verified"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "engine": {
                "const": "reel-slot"
              }
            },
            "type": "object"
          },
          "then": {
            "properties": {
              "spec": {
                "additionalProperties": false,
                "required": [
                  "reels",
                  "lines",
                  "symbols",
                  "stakes"
                ],
                "properties": {
                  "reels": {
                    "type": "integer",
                    "enum": [
                      3,
                      5
                    ]
                  },
                  "lines": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 25
                  },
                  "symbols": {
                    "type": "array",
                    "minItems": 6,
                    "maxItems": 10,
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "code",
                        "name"
                      ],
                      "properties": {
                        "code": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 1
                        },
                        "name": {
                          "type": "string"
                        },
                        "wild": {
                          "type": "boolean"
                        }
                      }
                    }
                  },
                  "stakes": {
                    "type": "array",
                    "minItems": 3,
                    "maxItems": 6,
                    "items": {
                      "type": "integer",
                      "minimum": 1
                    }
                  },
                  "targetRtp": {
                    "type": "number",
                    "minimum": 0.9,
                    "maximum": 0.99
                  }
                },
                "type": "object"
              }
            },
            "type": "object"
          }
        },
        {
          "if": {
            "properties": {
              "engine": {
                "const": "european-roulette"
              }
            },
            "type": "object"
          },
          "then": {
            "properties": {
              "spec": {
                "additionalProperties": false,
                "required": [
                  "chips",
                  "tableLimit",
                  "pocketNames"
                ],
                "properties": {
                  "chips": {
                    "type": "array",
                    "minItems": 3,
                    "maxItems": 6,
                    "items": {
                      "type": "integer",
                      "minimum": 1
                    }
                  },
                  "tableLimit": {
                    "type": "integer",
                    "minimum": 50
                  },
                  "pocketNames": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "red",
                      "black",
                      "zero"
                    ],
                    "properties": {
                      "red": {
                        "type": "string"
                      },
                      "black": {
                        "type": "string"
                      },
                      "zero": {
                        "type": "string"
                      }
                    }
                  }
                },
                "type": "object"
              }
            },
            "type": "object"
          }
        },
        {
          "if": {
            "properties": {
              "engine": {
                "const": "blackjack"
              }
            },
            "type": "object"
          },
          "then": {
            "properties": {
              "spec": {
                "additionalProperties": false,
                "required": [
                  "decks",
                  "dealer",
                  "naturalName",
                  "naturalPays",
                  "hint",
                  "stakes"
                ],
                "properties": {
                  "decks": {
                    "type": "integer",
                    "enum": [
                      4,
                      6,
                      8
                    ]
                  },
                  "dealer": {
                    "type": "string",
                    "enum": [
                      "S17",
                      "H17"
                    ]
                  },
                  "naturalName": {
                    "type": "string"
                  },
                  "naturalPays": {
                    "const": "3:2"
                  },
                  "hint": {
                    "type": "boolean"
                  },
                  "stakes": {
                    "type": "array",
                    "minItems": 3,
                    "maxItems": 6,
                    "items": {
                      "type": "integer",
                      "minimum": 1
                    }
                  }
                },
                "type": "object"
              }
            },
            "type": "object"
          }
        }
      ]
    }
  }
}
